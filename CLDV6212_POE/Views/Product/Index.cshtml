@model IEnumerable<CLDV6212_POE.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Product List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Product</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductDescription)
            </th>
            <th>Image</th>
            <th>
                @Html.DisplayNameFor(model => model.ProductNumber)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductDescription)
            </td>
            <td>
                    @if (!string.IsNullOrEmpty(item.ImageURL))
                    {
                        <img src="@item.ImageURL" alt="@item.ProductNumber"
                             class="img-thumbnail" style="width: 80px; height: 60px; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted">No Image</span>
                    }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductNumber)
            </td>
            <td>
                    <!--This function with partion key and row key to select Entity-->
                    <div class="btn-group" role="group">
                        <a asp-action="Read" asp-route-partitionKey="@item.PartitionKey"
                           asp-route-rowKey="@item.RowKey" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Update" asp-route-partitionKey="@item.PartitionKey"
                           asp-route-rowKey="@item.RowKey" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-partitionKey="@item.PartitionKey"
                           asp-route-rowKey="@item.RowKey" class="btn btn-sm btn-danger">Delete</a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>
