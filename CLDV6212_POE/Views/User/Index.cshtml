@model List<CLDV6212_POE.Models.Product>

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    <!-- Welcome Banner -->
    <div class="jumbotron bg-light p-5 rounded mb-4">
        <h1 class="display-4">Welcome to ABC Retail!</h1>
        <p class="lead">Discover our amazing products at great prices.</p>
        <hr class="my-4">
        <p>Browse our collection and find what you need today.</p>
        <a class="btn btn-primary btn-lg" asp-action="Shop" role="button">
            <i class="fas fa-shopping-bag"></i> Start Shopping
        </a>
    </div>

    <!-- Featured Products Section -->
    <h2 class="mb-4">Featured Products</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.ImageURL))
                        {
                            <img src="@product.ImageURL" class="card-img-top" alt="@product.ProductName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-image fa-3x text-white"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text flex-grow-1">@product.ProductDescription</p>
                            <div class="mt-auto">
                                <button class="btn btn-primary w-100 add-to-cart" data-product-id="@product.ProductNumber">
                                    <i class="fas fa-cart-plus"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <a asp-action="Shop" class="btn btn-outline-primary btn-lg">
                View All Products <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No products available at the moment. Check back soon!
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.add-to-cart').click(function() {
                var productId = $(this).data('product-id');
                var button = $(this);

                button.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("AddToCart", "User")',
                    type: 'POST',
                    data: { productId: productId },
                    success: function(response) {
                        if (response.success) {
                            // Update cart count in navbar
                            $('.badge').text(response.cartCount);

                            // Show success message
                            alert(response.message);
                        } else {
                            alert(response.message);
                        }
                        button.prop('disabled', false);
                    },
                    error: function() {
                        alert('Error adding product to cart');
                        button.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}