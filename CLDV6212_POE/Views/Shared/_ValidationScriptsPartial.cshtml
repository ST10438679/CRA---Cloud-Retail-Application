@* Validation Scripts for Bootstrap Integration *@

<!-- jQuery Validation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(document).ready(function () {
        // Add Bootstrap classes to validation messages
        $(".field-validation-error").addClass("text-danger");
        $(".field-validation-valid").addClass("text-success");

        // Add Bootstrap classes to form inputs with validation errors
        $("input.input-validation-error").addClass("is-invalid");
        $("select.input-validation-error").addClass("is-invalid");

        // Auto-hide alerts after 5 seconds
        $(".alert").delay(5000).fadeOut();

        // Add Bootstrap validation styling on form submit
        $("form").submit(function () {
            $(this).find("input, select, textarea").each(function () {
                if ($(this).valid()) {
                    $(this).removeClass("is-invalid").addClass("is-valid");
                } else {
                    $(this).removeClass("is-valid").addClass("is-invalid");
                }
            });
        });
    });
</script>

