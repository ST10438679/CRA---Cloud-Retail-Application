@{
    var hideNavigation = ViewData["HideNavigation"] as bool? ?? false;
    var userRole = Context.Session.GetString("Role");
    var userName = Context.Session.GetString("UserName");
    var userSurname = Context.Session.GetString("UserSurname");
    var isAuthenticated = !string.IsNullOrEmpty(userRole);

    // Get cart count from Azure Table Storage
    int cartCount = 0;
    if (userRole == "Customer")
    {
        var customerNumber = Context.Session.GetString("CustomerNumber");
        if (!string.IsNullOrEmpty(customerNumber))
        {
            // This will be set by the controller actions
            cartCount = ViewBag.CartCount ?? 0;
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <header>
        @if (hideNavigation)
        {
            <!-- Simple Purple Header for Login -->
            <nav class="navbar navbar-dark mb-3" style="background-color: #8a63d2;">
                <div class="container-fluid">
                    <span class="navbar-brand mx-auto">
                        <i class="fas fa-store"></i> ABC Retail
                    </span>
                </div>
            </nav>
        }
        else if (isAuthenticated)
        {
            @if (userRole == "Admin")
            {
                <!-- Admin Navigation -->
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: #8a63d2;">
                    <div class="container-fluid">
                        <span class="navbar-brand">
                            <i class="fas fa-store"></i> ABC Retail - Admin
                        </span>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                        <i class="fas fa-home"></i> Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Customer" asp-action="Index">
                                        <i class="fas fa-users"></i> Customers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">
                                        <i class="fas fa-box"></i> Products
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Order" asp-action="Index">
                                        <i class="fas fa-shopping-cart"></i> Orders
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Contracts" asp-action="Index">
                                        <i class="fas fa-chart-bar"></i> Contracts
                                    </a>
                                </li>
                            </ul>
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user-shield"></i> @userName @userSurname
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            }
            else if (userRole == "Customer")
            {
                <!-- Customer Navigation -->
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: #8a63d2;">
                    <div class="container-fluid">
                        <span class="navbar-brand">
                            <i class="fas fa-store"></i> ABC Retail
                        </span>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="User" asp-action="Index">
                                        <i class="fas fa-home"></i> Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="User" asp-action="Shop">
                                        <i class="fas fa-shopping-bag"></i> Shop
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="User" asp-action="Orders">
                                        <i class="fas fa-receipt"></i> My Orders
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="User" asp-action="Cart">
                                        <i class="fas fa-shopping-cart"></i> Cart
                                        <span class="badge bg-light text-dark">@cartCount</span>
                                    </a>
                                </li>
                            </ul>
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" id="customerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user"></i> @userName @userSurname
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="customerDropdown">
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            }
        }
        <!-- No navigation bar shown when hideNavigation is true or user is not authenticated -->
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (ViewData["HideFooter"] as bool? != true)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; @DateTime.Now.Year - ABC Retail. All rights reserved.
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Ensure Bootstrap dropdowns work -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var dropdownElementList = [].slice.call(document.querySelectorAll('[data-bs-toggle="dropdown"]'));
            var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
                return new bootstrap.Dropdown(dropdownToggleEl);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>