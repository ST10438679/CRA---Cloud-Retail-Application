@model CLDV6212_POE.Models.Customer

@{
    ViewData["Title"] = "Delete";
}

<h1>Deletion</h1>

<h3>Are you sure you want to delete this?</h3>
<div class="card">
    <div class="card-header">
        <h4>Customer Details</h4>
        </div>
    <div class="card-body">
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CustomerName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CustomerName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CustomerSurname)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CustomerSurname)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CustomerEmail)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CustomerEmail)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CustomerPassword)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CustomerPassword)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CustomerNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CustomerNumber)
        </dd>
    </dl>

    <div class="mt-3"
    <form asp-action="Deletes">
        <form asp-action="Deletes" method="post" class="d-inline">
        <input type="hidden" asp-for="PartitionKey" />
        <input type="hidden" asp-for="RowKey" />
        <input type="submit" value="Delete" class="btn btn-danger me-2"
               onclick="return confirm('Are you sure you want to delete this order?')" />
    </form>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
